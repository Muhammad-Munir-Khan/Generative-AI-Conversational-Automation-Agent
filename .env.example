# Copy to .env and customize. All values are optional; sensible defaults shipped in app/core/config.py.

# --- LLM ---
ollama_chat_model=llama3.2:3b
LLM_TEMPERATURE=0.1
OLLAMA_BASE_URL=http://localhost:11434

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Retrieval ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=4

# --- Agent ---
MAX_AGENT_ITERATIONS=6
MEMORY_WINDOW=10

# --- Voice ---
WHISPER_MODEL=base
WHISPER_COMPUTE_TYPE=int8
ENABLE_VOICE=true

# --- Tools ---
ENABLE_WEB_SEARCH=true
ENABLE_CALCULATOR=true
WEB_SEARCH_MAX_RESULTS=4

# --- Observability (optional, requires self-hosted Langfuse) ---
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3000
